{
  "name": "@symtype/server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --platform node --target node20 --sourcemap --clean --external better-sqlite3",
    "start": "node dist/index.js",
    "migrate": "node --import tsx src/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.0",
    "@symtype/content": "*",
    "@symtype/shared": "*",
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.6.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1"
  }
}
